  "updated_at": "2026-05-22T00:00:00+08:00",
  "task_id": "quest3_vr_lerobot_pi05_v1",
  "required_modalities": [
    "rgb",
    "depth",
    "state",
    "action",
    "text"
  ],
  "episode_layout": {
    "metadata_file": "metadata.json",
    "language_file": "language.json",
    "rgb_dir": "rgb",
    "depth_dir": "depth",
    "visuals_file": "visuals.jsonl",
    "states_file": "states.jsonl",
    "actions_file": "actions.jsonl",
    "relations_file": "relations.jsonl",
    "events_file": "events.jsonl",
    "phase_labels_file": "phase_labels.jsonl",
    "result_file": "result.json",
    "validation_summary_file": "validation_summary.json"
  },
  "camera_source_policy": {
    "primary_visual_source": "intel_realsense_d405",
    "required_rgb_camera_name": "d405_rgb",
    "required_depth_camera_name": "d405_depth",
    "forbidden_training_sources": [
      "quest3_page_capture",
      "threejs_observer_camera",
      "camera_base",
      "camera",
      "stub_frame"
    ],
    "mp4_preview_only": true,
    "stub_frame_for_training_forbidden": true
  },
  "image_storage": {
    "rgb": {
      "allowed_formats": [
        "jpg",
        "png"
      ],
      "default_format": "jpg"
    },
    "depth": {
      "allowed_formats": [
        "png16",
        "npy"
      ],
      "default_format": "png16",
      "lossy_forbidden": true,
      "depth_unit": "millimeter",
      "depth_scale": 1.0
    }
  },
  "metadata_required_fields": [
    "task_id",
    "session_id",
    "episode_id",
    "captured_at",
    "input_mode",
    "input_source",
    "runtime_target",
    "instruction_text",
    "collection_stage",
    "episode_type",
    "handover_object_id",
    "handover_object_class",
    "handover_zone_id",
    "camera_device",
    "camera_mount_name",
    "camera_intrinsics_version",
    "camera_extrinsics_version"
  ],
  "visual_sample_required_fields": [
    "timestamp",
    "frame_id",
    "d405_frame_id",
    "rgb_path",
    "depth_path",
    "rgb_timestamp",
    "depth_timestamp",
    "frame_aligned",
    "camera_pose_in_ee",
    "camera_pose_in_base",
    "rgb_missing",
    "depth_missing",
    "rgb_valid",
    "depth_valid",
    "camera_source_ok",
    "stub_frame_used",
    "visual_valid"
