  "state_sample_required_fields": [
    "timestamp",
    "sim_time",
    "qpos",
    "qvel",
    "ee_pose",
    "gripper_opening",
    "objects",
    "camera_capture_ok",
    "d405_frame_id",
    "camera_observation",
    "instruction_text"
  ],
  "action_sample_required_fields": [
    "command_timestamp",
    "ack_timestamp",
    "target_positions",
    "gripper_command",
    "input_mode",
    "runtime_target",
    "paired_frame_id",
    "instruction_text"
  ],
  "validation_summary_required_fields": [
    "camera_source_ok",
    "camera_capture_ok",
    "camera_view_ok",
    "frame_alignment_ok",
    "rgb_valid",
    "depth_valid",
    "stub_frame_used"
  ],
  "alignment_rules": {
    "paired_frame_required_for_each_action": true,
    "instruction_text_required_in_metadata_and_step": true,
    "max_rgb_depth_delta_ms": 5.0,
    "state_action_visual_alignment_required": true
  },
  "sample_rejection_labels_reserve": [
