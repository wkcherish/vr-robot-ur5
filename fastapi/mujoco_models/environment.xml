<mujoco model="ur5_environment">
  <compiler angle="radian" meshdir="meshes/"/>

  <option timestep="0.002" gravity="0 0 -9.81" integrator="RK4"/>

  <asset>
    <!-- UR5 meshes -->
    <mesh name="base_collision" file="collision/base.stl"/>
    <mesh name="shoulder_collision" file="collision/shoulder.stl"/>
    <mesh name="upperarm_collision" file="collision/upperarm.stl"/>
    <mesh name="forearm_collision" file="collision/forearm.stl"/>
    <mesh name="wrist1_collision" file="collision/wrist1.stl"/>
    <mesh name="wrist2_collision" file="collision/wrist2.stl"/>
    <mesh name="wrist3_collision" file="collision/wrist3.stl"/>
    <mesh name="grasp_collision" file="collision/grasp.stl"/>
  </asset>

  <worldbody>
    <!-- Ground plane -->
    <geom name="floor" type="plane" size="5 5 0.1" rgba="0.8 0.8 0.8 1" pos="0 0 -0.1"/>

    <!-- UR5 Robot -->
    <body name="base_link" pos="0 0 0">
      <inertial mass="4.0" pos="0 0 0" diaginertia="0.00443333156 0.00443333156 0.0072"/>
      <geom type="mesh" mesh="base_collision" rgba="0.7 0.7 0.7 1"/>

      <!-- Shoulder joint -->
      <body name="shoulder_link" pos="0 0 0.08926472961334342">
        <inertial mass="3.7" pos="0 0 0" diaginertia="0.014972352344389999 0.014972352344389999 0.01040625"/>
        <joint name="shoulder_pan_joint" type="hinge" axis="0 0 1" range="-6.283185307179586 6.283185307179586" damping="0.0" frictionloss="0.0"/>
        <geom type="mesh" mesh="shoulder_collision" rgba="0.7 0.7 0.7 1"/>

        <!-- Upper arm joint -->
        <body name="upper_arm_link" pos="1.382981019957065e-05 0 0" quat="0.7071067811865476 0 0 0.7071067811865475">
          <inertial mass="8.393" pos="-0.21276217125807406 0 0.136" diaginertia="0.13419769784234978 0.13419769784234978 0.0151074"/>
          <joint name="shoulder_lift_joint" type="hinge" axis="0 0 1" range="-6.283185307179586 6.283185307179586" damping="0.0" frictionloss="0.0"/>
          <geom type="mesh" mesh="upperarm_collision" rgba="0.7 0.7 0.7 1"/>

          <!-- Forearm joint -->
          <body name="forearm_link" pos="-0.4255243425161481 0 0">
            <inertial mass="2.275" pos="-0.21276217125807406 0 0.0165" diaginertia="0.03126090194636795 0.03126090194636795 0.004095"/>
            <joint name="elbow_joint" type="hinge" axis="0 0 1" range="-3.141592653589793 3.141592653589793" damping="0.0" frictionloss="0.0"/>
            <geom type="mesh" mesh="forearm_collision" rgba="0.7 0.7 0.7 1"/>

            <!-- Wrist 1 joint -->
            <body name="wrist_1_link" pos="-0.3925464756742949 3.997758627401243e-05 0.109834154848806">
              <inertial mass="1.219" pos="0 0 0" diaginertia="0.0026289458299555654 0.0026289458299555654 0.0034284375"/>
              <joint name="wrist_1_joint" type="hinge" axis="0 0 1" range="-6.283185307179586 6.283185307179586" damping="0.0" frictionloss="0.0"/>
              <geom type="mesh" mesh="wrist1_collision" rgba="0.7 0.7 0.7 1"/>

              <!-- Wrist 2 joint -->
              <body name="wrist_2_link" pos="7.272823462586377e-05 -0.09489313353003985 4.425303093784125e-05">
                <inertial mass="1.219" pos="0 0 0" diaginertia="0.0017911354634331433 0.0017911354634331433 0.0021942"/>
                <joint name="wrist_2_joint" type="hinge" axis="0 0 1" range="-6.283185307179586 6.283185307179586" damping="0.0" frictionloss="0.0"/>
                <geom type="mesh" mesh="wrist2_collision" rgba="0.7 0.7 0.7 1"/>

                <!-- Wrist 3 joint -->
                <body name="wrist_3_link" pos="-9.254952564112848e-05 0.08265703556271481 2.776642265747963e-05">
                  <inertial mass="0.1879" pos="0 0 -0.01525" diaginertia="8.062472608343e-05 8.062472608343e-05 0.0001321171875"/>
                  <joint name="wrist_3_joint" type="hinge" axis="0 0 1" range="-6.283185307179586 6.283185307179586" damping="0.0" frictionloss="0.0"/>
                  <geom type="mesh" mesh="wrist3_collision" rgba="0.7 0.7 0.7 1"/>

                  <!-- Gripper joint -->
                  <body name="gr_link" pos="0 0.09 0" quat="0.7071067811865476 0 0 0.7071067811865475">
                    <inertial mass="0.1879" pos="0 0.0771 0" diaginertia="9.89041005217e-05 9.89041005217e-05 0.0001321171875"/>
                    <joint name="gr_joint" type="hinge" axis="0 1 0" range="-6.28318530718 6.28318530718" damping="0.0" frictionloss="0.0"/>
                    <geom type="mesh" mesh="grasp_collision" rgba="0.7 0.7 0.7 1"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- Battery -->
    <body name="battery_base" pos="-1.5 0 0.2">
      <inertial mass="15.57" pos="0.55262 0.63542 0.59184" diaginertia="0.30648 0.7762 1.0218"/>
      <geom type="box" size="0.8 0.6 0.4" pos="0.4 0.3 0.2" rgba="0.8 0.8 0.8 1"/>
    </body>

    <!-- Rack -->
    <body name="rack_base" pos="1.5 0 0.9">
      <inertial mass="49.112" pos="-0.011971 0.0044869 -0.4297" diaginertia="9.9116 21.362 28"/>
      <geom type="box" size="1.0 0.8 1.8" pos="0 0 -0.9" rgba="0.75 0.76 0.78 1"/>
    </body>

    <!-- Camera Base -->
    <body name="camera_base" pos="0 1.5 0.5" quat="0.7071067811865476 0 0 0.7071067811865475">
      <inertial mass="15.57" pos="0.55262 0.63542 0.59184" diaginertia="0.30648 0.7762 1.0218"/>
      <geom type="box" size="0.8 0.6 0.4" pos="0.4 0.3 0.2" rgba="1 1 1 1"/>
    </body>
  </worldbody>

  <actuator>
    <!-- UR5 Position actuators for PD control -->
    <position name="shoulder_pan" joint="shoulder_pan_joint" kp="1000" kv="100"/>
    <position name="shoulder_lift" joint="shoulder_lift_joint" kp="1000" kv="100"/>
    <position name="elbow" joint="elbow_joint" kp="1000" kv="100"/>
    <position name="wrist_1" joint="wrist_1_joint" kp="300" kv="30"/>
    <position name="wrist_2" joint="wrist_2_joint" kp="300" kv="30"/>
    <position name="wrist_3" joint="wrist_3_joint" kp="300" kv="30"/>
  </actuator>

  <sensor>
    <!-- UR5 Joint position sensors -->
    <jointpos name="shoulder_pan_pos" joint="shoulder_pan_joint"/>
    <jointpos name="shoulder_lift_pos" joint="shoulder_lift_joint"/>
    <jointpos name="elbow_pos" joint="elbow_joint"/>
    <jointpos name="wrist_1_pos" joint="wrist_1_joint"/>
    <jointpos name="wrist_2_pos" joint="wrist_2_joint"/>
    <jointpos name="wrist_3_pos" joint="wrist_3_joint"/>

    <!-- UR5 Joint velocity sensors -->
    <jointvel name="shoulder_pan_vel" joint="shoulder_pan_joint"/>
    <jointvel name="shoulder_lift_vel" joint="shoulder_lift_joint"/>
    <jointvel name="elbow_vel" joint="elbow_joint"/>
    <jointvel name="wrist_1_vel" joint="wrist_1_joint"/>
    <jointvel name="wrist_2_vel" joint="wrist_2_joint"/>
    <jointvel name="wrist_3_vel" joint="wrist_3_joint"/>

    <!-- UR5 Joint force/torque sensors -->
    <jointactuatorfrc name="shoulder_pan_frc" joint="shoulder_pan_joint"/>
    <jointactuatorfrc name="shoulder_lift_frc" joint="shoulder_lift_joint"/>
    <jointactuatorfrc name="elbow_frc" joint="elbow_joint"/>
    <jointactuatorfrc name="wrist_1_frc" joint="wrist_1_joint"/>
    <jointactuatorfrc name="wrist_2_frc" joint="wrist_2_joint"/>
    <jointactuatorfrc name="wrist_3_frc" joint="wrist_3_joint"/>
  </sensor>
</mujoco>
